# Copy this file to `.env.local` and fill in the values.
#
# Local stack:   `npm run db:start` prints API_URL and PUBLISHABLE_KEY.
#                (URL is http://127.0.0.1:54321)
# Hosted:        Supabase Dashboard → Project Settings → API.
#
# Only PUBLIC values belong here. Everything prefixed with VITE_ is bundled
# into the browser build and is visible to every player.
# NEVER put the service-role / secret key in any VITE_ variable.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://bossvjdevwbkhagllgco.supabase.co

# Publishable key (sb_publishable_...) or legacy anon key. Safe for browsers;
# access is enforced by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vqTHfRNluI6n3MCZvW40tA_tTmBGr_N

# Optional (recommended for production): bot protection for anonymous sign-ins.
# Both values are PUBLIC. The CAPTCHA *secret* is configured only in Supabase
# (Authentication → Attack Protection). See docs/production.md.
# VITE_CAPTCHA_PROVIDER=turnstile        # or: hcaptcha
# VITE_CAPTCHA_SITE_KEY=
